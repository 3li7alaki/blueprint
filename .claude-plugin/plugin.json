{
  "name": "blueprint",
  "description": "Grill the idea until it has no holes, then hand your agents a spec they can't misread. Spec-anchored development with slug traceability, priced unknowns, and mechanical gates.",
  "author": {
    "name": "3li7alaki",
    "url": "https://github.com/3li7alaki"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "blueprint hook session",
            "timeout": 10,
            "statusMessage": "Reading the blueprint..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "blueprint hook pre-write",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "blueprint hook done",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
